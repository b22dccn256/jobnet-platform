# ============================================================================
# JobNet Platform – Cấu hình chung phía Server & Hạ tầng
# Dùng chung cho: infra/, backend/, chatbot/, crawler/
# (Riêng frontend/ dùng file frontend/.env.local)
# ============================================================================

# --- 1. Hạ tầng Docker (MongoDB & MinIO root credentials) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_too

# --- 2. Kết nối MongoDB (dùng chung cho Backend, Chatbot, Crawler) ---
# Mặc định khi chạy MongoDB bằng Docker Compose:
MONGO_URI=mongodb://admin:change_me@localhost:27017/jobnet?authSource=admin
# Nếu chạy MongoDB cài trực tiếp trên máy (không mật khẩu):
# MONGO_URI=mongodb://localhost:27017/jobnet

# --- 3. Backend (NestJS) ---
PORT=4000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

ELASTICSEARCH_NODE=http://localhost:9200

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_too
MINIO_BUCKET=jobnet

CHATBOT_URL=http://localhost:8000

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/employer/payment/vnpay-return

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="JobNet <no-reply@jobnet.local>"

# --- 4. Chatbot AI (Flask + Groq LLM) ---
CHATBOT_PORT=8000
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- 5. Web Crawler (Scrapy) ---
# URL các trang tuyển dụng công khai cần thu thập, cách nhau bằng dấu phẩy (tuân thủ robots.txt)
START_URLS=
